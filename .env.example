# Canonical runtime mode. Use "paper" by default and switch to "live" explicitly.
DARWIN_MODE=paper

# Solana RPC / websocket
RPC_URL=https://example-rpc.invalid
RPC_URLS=https://example-rpc.invalid
WSS_URL=wss://example-rpc.invalid
DARWIN_RPC_MAX_CONCURRENT=2
DARWIN_RPC_MIN_SPACING_MS=150
DARWIN_RPC_MAX_429_RETRIES=2
DARWIN_RPC_BASE_BACKOFF_MS=400
DARWIN_RPC_MAX_BACKOFF_MS=4000
DARWIN_RPC_BATCH_SIZE=50
DARWIN_PRICE_POLL_INTERVAL_MS=5000
DARWIN_POOL_PRICE_CACHE_TTL_MS=5000
PUMPSWAP_META_RUN_HOURS=4
PUMPSWAP_META_MAX_QUEUE_DEPTH=10000

# Darwin runtime
STARTING_BALANCE_SOL=1.0
DARWIN_POP_SIZE=16
DARWIN_RESEARCH_MODE=false
DARWIN_GENERATION_INTERVAL_MIN=60
DARWIN_GENERATION_TRADE_THRESHOLD=75
DARWIN_STABLE_GENERATION_INTERVAL_MIN=60
DARWIN_STABLE_GENERATION_TRADE_THRESHOLD=75
DB_PATH=darwin.db
LOG_DIR=logs
TRADES_PATH=trades.jsonl
GRAVEYARD_PATH=graveyard.jsonl
GENERATION_LOG_PATH=logs/generation_log.jsonl
BANKROLL_PATH=logs/bankroll.jsonl
SIGNAL_SKIPS_PATH=logs/signal_skips.jsonl
MIGRATION_MIN_LIQUIDITY_SOL=25
NEW_POOL_MIN_LIQUIDITY_SOL=30
AMM_ACTIVITY_MIN_LIQUIDITY_SOL=50
WHALE_BUY_MIN_LIQUIDITY_SOL=50
DARWIN_TARGET_ENTRY_POOL_PCT=0.03
DARWIN_MIN_MEANINGFUL_FILL_RATIO=0.5
DARWIN_PAPER_MAX_POSITION_PCT=0.12
# Optional absolute paper cap if you want one; leave unset to let paper scale with bankroll.
# DARWIN_PAPER_MAX_POSITION_SOL=1.0

# Live trading
LIVE_TRADE_SIZE_SOL=0.001
LIVE_MIN_BALANCE_SOL=1.0
PRIVATE_KEY=replace-with-base58-or-json-secret-key

# Autoresearch
OPENAI_API_KEY=replace-with-project-api-key
OPENAI_MODEL=gpt-5.3-codex
OPENAI_REASONING_EFFORT=medium
AUTORESEARCH_TARGET_APP=darwin-paper-research
AUTORESEARCH_EXPERIMENT_MINUTES=8
AUTORESEARCH_MIN_TRADES=30
AUTORESEARCH_VALIDATION_WINDOWS=2
AUTORESEARCH_MAX_WAIT_CYCLES=4
AUTORESEARCH_WAIT_MINUTES=10
AUTORESEARCH_MAX_EXPERIMENTS=200
# Optional mirror worktree to keep GitHub in sync with kept autoresearch commits.
# AUTORESEARCH_MIRROR_DIR=/home/benjijmac/darwin-push
# AUTORESEARCH_PUSH_AFTER_KEEP=true
