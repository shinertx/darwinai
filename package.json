{
  "name": "darwin",
  "version": "1.0.0",
  "description": "Darwin — Evolutionary Trading Organism for Solana PumpSwap",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:paper": "DARWIN_MODE=paper node dist/index.js",
    "start:live": "DARWIN_MODE=live node dist/index.js",
    "dev": "ts-node src/index.ts",
    "pm2:start:paper": "pm2 start ecosystem.config.cjs --only darwin-paper",
    "pm2:start:live": "pm2 start ecosystem.config.cjs --only darwin-live",
    "pm2:start:autoresearch": "pm2 start ecosystem.config.cjs --only darwin-autoresearch"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@pump-fun/pump-swap-sdk": "^1.14.1",
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.98.4",
    "bn.js": "^5.2.3",
    "better-sqlite3": "^9.0.0",
    "bs58": "^6.0.0",
    "cross-fetch": "^4.1.0",
    "dotenv": "^16.0.0",
    "uuid": "^9.0.0",
    "ws": "^7.5.10"
  },
  "devDependencies": {
    "@types/bn.js": "^5.2.0",
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^20.0.0",
    "@types/uuid": "^9.0.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.0.0"
  }
